{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "./dockerfile"
    },
    "deploy": {
        "runtime": "V2",
        "numReplicas": 1,
        "startCommand": "prometheus --config.file=/etc/prometheus/prom.yml --storage.tsdb.path=/prometheus --web.enable-remote-write-receiver",
        "healthcheckPath": "/-/healthy",
        "sleepApplication": false,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "volumes": [
            {
                "path": "/prometheus",
                "volumeName": "prometheus_data"
            }
        ]
    }
}